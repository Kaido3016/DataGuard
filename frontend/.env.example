# DataGuard frontend — build-time configuration (no secrets belong here: every
# VITE_* value is embedded in the public bundle).

# Base URL of the DataGuard API. Leave empty to use the same origin (dev proxy or
# a reverse proxy that routes /api and /health to the backend).
VITE_API_BASE_URL=

# Client-side request timeout in milliseconds (analysis of large documents may need more).
VITE_REQUEST_TIMEOUT_MS=60000

# Show the local-development sign-in form. The backend only enables /auth/login when
# DATAGUARD_ENVIRONMENT=development, so production deployments should set this to false.
VITE_ENABLE_DEV_LOGIN=true

# Allow switching to the clearly labelled synthetic demo workspace (Settings page).
# Keep "false" for production builds so demo data can never be presented as real.
VITE_ENABLE_DEMO_MODE=false
